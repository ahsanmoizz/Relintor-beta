{
  "name": "relintor",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "spec:verify": "python tooling/spec/verify_spec.py",
    "traceability:verify": "python tooling/acceptance/verify_traceability.py",
    "desktop:dev": "pnpm --dir apps/desktop dev",
    "desktop:build": "pnpm --dir apps/desktop build",
    "desktop:test": "pnpm --dir apps/desktop test",
    "desktop:typecheck": "pnpm --dir apps/desktop typecheck",
    "desktop:lint": "pnpm --dir apps/desktop lint"
  }
}
